set -eu

# -- Source useful functions.
# shellcheck source=/dev/null

source /configs/scripts/others/misc-funcs


# -- Remove these lines from /usr/share/initramfs-tools/scripts/casper because they're relevant in Ubuntu but not here.

sed -i '/touch \/root\/var\/crash\/crash.init/d; /rm \/root\/var\/crash\/crash.init/d' /usr/share/initramfs-tools/scripts/casper


# -- Check if the root account is disabled, if not, disable it by locking it.

if [[ $(passwd -S root | awk '{print $2}') == "L" ]]; then
   echo "Root account is already disabled"
else
   passwd -l root
   echo "Root account has been disabled"
fi


# -- Remove these scripts from casper as we don't use them.

DELETE_CASPER_SCRIPTS=(
    31disable_update_notifier
    33enable_apport_crashes
    52gnome_initial_setup
    53disable_unattended_upgrades
    59disable_mozc_autosetup
)

rm -f "${DELETE_CASPER_SCRIPTS[@]/#//usr/share/initramfs-tools/scripts/casper-bottom/}"


# -- Edit console-setup to match the user settings.

update_console_settings ACTIVE_CONSOLES '/dev/tty[1-6]'
update_console_settings CHARMAP 'UTF-8'
update_console_settings VIDEOMODE ''
update_console_settings CODESET 'Uni2'
update_console_settings FONTFACE 'Terminus'
update_console_settings FONTSIZE '16'


# -- Add motd.

cat /configs/files/other/motd > /etc/motd


# -- Ensure Hyprland session is launched with D-Bus (OpenRC) from the greeter when using greetd.
# -- See: https://wiki.gentoo.org/wiki/Greetd#Hyprland_session_with_D-Bus_.28OpenRC.29

DESKTOP_FILE="/usr/share/wayland-sessions/hyprland.desktop"

if [ -f "$DESKTOP_FILE" ] && ! grep -q "Exec=dbus-run-session Hyprland" "$DESKTOP_FILE"; then
    sed -i 's|^Exec=Hyprland|Exec=dbus-run-session Hyprland|' "$DESKTOP_FILE"
fi
